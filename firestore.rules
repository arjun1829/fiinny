rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- helpers (kept from your file + new owner helper) ---
    function authed() {
      return request.auth != null;
    }
    function authPhone() {
      return authed() && request.auth.token.phone_number is string
        ? request.auth.token.phone_number
        : "";
    }
    // A user "owns" a /users/{uid} doc if:
    // - the path id equals their Firebase uid, OR
    // - the doc stores their uid in resource.data.uid, OR
    // - the path id equals their verified phone number (for your phone-key mirror)
    function isUserOwner(uid) {
      return authed()
        && (
          request.auth.uid == uid
          || (resource.data.uid == request.auth.uid)
          || (uid == authPhone())
        );
    }

    // --- secure only partner_requests (unchanged) ---
    match /partner_requests/{reqId} {
      // Only the sender can create a pending request
      allow create: if authed()
                    && request.resource.data.fromUserPhone == authPhone()
                    && request.resource.data.status == 'pending';

      // Only the recipient can approve/reject a pending request
      // Only the sender can cancel a pending request
      allow update: if authed()
                    && resource.data.status == 'pending'
                    && (
                         // recipient approves/rejects
                         (resource.data.toUserPhone == authPhone()
                          && (request.resource.data.status == 'approved'
                              || request.resource.data.status == 'rejected'))
                         ||
                         // sender cancels
                         (resource.data.fromUserPhone == authPhone()
                          && request.resource.data.status == 'cancelled')
                       );

      // Only participants can read
      allow get, list: if authed()
                       && (resource.data.fromUserPhone == authPhone()
                           || resource.data.toUserPhone == authPhone());

      // Keep history
      allow delete: if false;
    }

    // --- NEW: secure users subtree used by notifications/prefs/feed ---
    match /users/{uid} {
      // User root doc: Web admin dashboard needs public read.
      allow read: if true;
      allow write: if isUserOwner(uid);

      match /activityLog/{date} {
        allow read: if true;
        allow write: if isUserOwner(uid);
      }

      // Notification preferences: owner only
      match /prefs/{doc} {
        allow read, write: if isUserOwner(uid);
      }

      // In-app notification feed: owner only
      match /notif_feed/{nid} {
        allow read, write: if isUserOwner(uid);
      }

      // Idempotency markers: owner may read (debug), but client may NOT write.
      // Cloud Functions (Admin SDK) bypasses security rules and can write here.
      match /recent_notifs/{rid} {
        allow read: if isUserOwner(uid);
        allow write: if false;
      }
    }

    // --- Explicitly secure main user collections ---
    // Instead of relying on the catch-all, we define them here for CASA compliance.
    
    // User Expenses
    match /users/{uid}/expenses/{docId} {
      allow read, write: if isUserOwner(uid);
    }
    // User Incomes
    match /users/{uid}/incomes/{docId} {
      allow read, write: if isUserOwner(uid);
    }
    // User Goals
    match /users/{uid}/goals/{docId} {
      allow read, write: if isUserOwner(uid);
    }
    // User Loans
    match /users/{uid}/loans/{docId} {
      allow read, write: if isUserOwner(uid);
    }
    // User Assets
    match /users/{uid}/assets/{docId} {
      allow read, write: if isUserOwner(uid);
    }
    // User Friends
    match /users/{uid}/friends/{docId} {
      allow read, write: if isUserOwner(uid);
    }
    // User Credit Cards
    match /users/{uid}/credit_cards/{docId} {
      allow read, write: if isUserOwner(uid);
    }
    // User Budget
    match /users/{uid}/budgets/{docId} {
      allow read, write: if isUserOwner(uid);
    }
    // User Bill Reminders
    match /users/{uid}/bill_reminders/{docId} {
      allow read, write: if isUserOwner(uid);
    }
    // Ingest Jobs (for off-device processing)
    match /users/{uid}/ingest_jobs/{jobId} {
      allow read, write: if isUserOwner(uid);
    }
    // Catch-all for any other user subcollections
    match /users/{uid}/{subcollection}/{docId} {
      allow read, write: if isUserOwner(uid);
    }
    
    // ╔══════════════════════════════════════════════════════════╗
    // ║       KARAN ARJUN SaaS — Tenant-Isolated B2B Rules       ║
    // ╚══════════════════════════════════════════════════════════╝

    // Helper: is the caller a verified member of this tenant?
    function isTenantMember(tenantId) {
      return authed() &&
        exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid));
    }

    // Tenant root document (business profile)
    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId);
      allow write: if isTenantMember(tenantId);

      // Members sub-collection (role management)
      match /members/{memberId} {
        allow read: if isTenantMember(tenantId);
        // Only existing admins can add/remove members
        allow write: if isTenantMember(tenantId) &&
          get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role == 'admin';
      }
    }

    // All tenant-scoped B2B collections (invoices, retailers, inventory, orders…)
    match /tenants/{tenantId}/{collection}/{docId} {
      allow read, write: if isTenantMember(tenantId);

      // Allow sub-collections (e.g. invoice line items)
      match /{subCollection}/{subDocId} {
        allow read, write: if isTenantMember(tenantId);
      }
    }

    // Public payment links — readable without auth (customer pays without logging in)
    match /paymentLinks_public/{token} {
      allow read: if true;                             // public: anyone with the token can pay
      allow create: if authed();                       // only logged-in staff can generate
      allow update: if authed();                       // only logged-in staff can mark paid
      allow delete: if false;                          // never delete — audit trail
    }

    // ──────────────────────────────────────────────────────────
    // KrishiDukaan-V2 collections
    // ──────────────────────────────────────────────────────────

    // Helper: check if caller is an admin by UID-keyed user doc
    function isAdmin() {
      return authed()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // UID → phone index: owner read/write only
    match /uidIndex/{uid} {
      allow read, write: if authed() && request.auth.uid == uid;
    }

    // Retailers: public read (brand/profile pages), owner or admin write
    match /retailers/{docId} {
      allow read: if true;
      allow write: if authed();
    }

    // Manufacturers: public read (brand/profile pages), authenticated write
    match /manufacturers/{docId} {
      allow read: if true;
      allow write: if authed();
    }

    // Subscriptions: owner can read their own, admin can read/write all
    match /subscriptions/{docId} {
      allow read: if authed();
      allow write: if authed();
    }

    // Payments (success log): authenticated read/write (admin checks at app layer)
    match /payments/{docId} {
      allow read: if authed();
      allow write: if authed();
    }

    // Failed payments: any authenticated user can write (log their own failure),
    // any authenticated user can read (admin panel has its own app-layer auth gate)
    match /failedPayments/{docId} {
      allow read: if authed();
      allow write: if authed();
    }

    // Retailer seat listings: authenticated read/write
    match /retailerSeatListings/{docId} {
      allow read: if authed();
      allow write: if authed();
    }

    // Promo codes: authenticated users can read (to validate at checkout),
    // writes are admin-only via server-side Admin SDK
    match /promoCodes/{docId} {
      allow read: if authed();
      allow write: if isAdmin();
    }

    // Public product/store listings: publicly readable, authenticated write
    match /listings/{docId} {
      allow read: if true;
      allow write: if authed();
    }

    // Partner invites
    match /partnerInvites/{docId} {
      allow read: if authed();
      allow write: if authed();
    }

    // ──────────────────────────────────────────────────────────
    // Existing Fiinny personal-finance rules (unchanged below)
    // ──────────────────────────────────────────────────────────

    // Groups & Shared (Authenticated users only, more complex logic can be added later)
    match /groups/{groupId} {
      allow read, write: if authed(); 
    }
    match /shared_expenses/{expId} {
       allow read, write: if authed();
    }
    match /chats/{chatId} {
       allow read, write: if authed();
    }
    // Chat Messages
    match /chats/{chatId}/messages/{msgId} {
       allow read, write: if authed();
    }
    
    // --- Default Deny (CASA Requirement) ---
    // Block all other access by default. 
    // "Closed unless open" policy.
    match /{document=**} {
      allow read, write: if false; 
    }
  }
}
