{
  "name": "krishidukan-analytics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Standalone KrishiDukan Analytics dashboard. Uses the existing FinERP UAT Firebase project (finny-erp-uat) for Auth + Firestore, deployed to its own Hosting site.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting:analytics --project finny-erp-uat"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.8",
    "firebase": "^12.11.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^5.0.3"
  }
}
