rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function getUserData() {
      let docRef = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(docRef) ? get(docRef).data : null;
    }
    
    function hasRole(roleName) {
      let data = getUserData();
      return data != null && data.role == roleName;
    }
    
    function getLinkedId() {
      let data = getUserData();
      return data != null ? data.linkedId : null;
    }

    function isAdminOrAnalyst() {
      let data = getUserData();
      return data != null && (data.role == 'admin' || data.role == 'analyst' || data.role == 'master');
    }
    
    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if request.auth != null && isAdminOrAnalyst();
    }
    
    // Online Orders schema
    match /onlineOrders/{orderId} {
      allow read, write: if request.auth != null && isAdminOrAnalyst();
    }
    
    // Master collections (tenantId = 'master')
    match /retailers/{rId} {
      allow read: if request.auth != null && (isAdminOrAnalyst() || (hasRole('retailer') && getLinkedId() == rId));
      allow write: if request.auth != null && isAdminOrAnalyst();
      
      match /{subcollection=**} {
        allow read, write: if request.auth != null && (isAdminOrAnalyst() || (hasRole('retailer') && getLinkedId() == rId));
      }
    }
    
    match /manufacturers/{mId} {
      allow read: if request.auth != null && (isAdminOrAnalyst() || (hasRole('manufacturer') && getLinkedId() == mId));
      allow write: if request.auth != null && isAdminOrAnalyst();
    }
    
    match /salesOrders/{soId} {
      allow read: if request.auth != null && (
        isAdminOrAnalyst() ||
        (hasRole('retailer') && resource.data.retailerId == getLinkedId()) ||
        (hasRole('manufacturer') && resource.data.manufacturerId == getLinkedId())
      );
      allow update: if request.auth != null && (isAdminOrAnalyst() || (hasRole('manufacturer') && resource.data.manufacturerId == getLinkedId()));
      allow create, delete: if request.auth != null && isAdminOrAnalyst();
    }
    
    match /orders/{oId} {
      allow read: if request.auth != null && (
        isAdminOrAnalyst() || 
        (hasRole('retailer') && resource.data.retailerId == getLinkedId())
      );
      allow write: if request.auth != null && isAdminOrAnalyst();
    }
    
    match /products/{pId} {
      allow read: if request.auth != null; // Everyone can read products
      allow write: if request.auth != null && isAdminOrAnalyst();
    }
    
    // Global module catalog — all authenticated users can read, only Cloud Functions write
    match /posModules/{moduleId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Tenant specific collections
    match /tenants/{tenantId} {
      // Allow users to read their own tenant, or master
      allow read: if request.auth != null && (tenantId == 'master' || (getUserData() != null && getUserData().tenantId == tenantId));

      // Allow users to create their own tenant during onboarding
      allow write: if request.auth != null && (
        tenantId == 'tenant_' + request.auth.uid ||
        (getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst())
      );

      // Module subscriptions — only Cloud Functions write, tenant members read
      match /modules/{moduleId} {
        allow read: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId;
        allow write: if false;
      }

      // Returns — admin/analyst full access
      match /returns/{returnId} {
        allow read, write: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst();
      }

      // Loyalty points — admin/analyst full access
      match /loyalty/{customerId} {
        allow read, write: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst();
      }

      // Loyalty configuration — canonical doc (settings/loyaltyConfig) plus the
      // legacy doc (settings/loyalty) kept readable/writable during the transition
      // so existing tenant config isn't stranded. Previously fell through to the
      // permissive catch-all at the bottom of this file with no tenant/role check;
      // this scopes it the same as every other tenant settings/business document.
      match /settings/loyaltyConfig {
        allow read, write: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst();
      }
      match /settings/loyalty {
        allow read, write: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst();
      }

      // Feedback — public create (no auth), tenant members read
      match /feedback/{feedbackId} {
        allow create: if true;
        allow read: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst();
        allow update, delete: if false;
      }

      // V-Checkout sessions — public read by token, Cloud Function updates, admin creates
      match /vcheckoutSessions/{sessionId} {
        allow read: if true;
        allow create: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst();
        allow update: if true;  // Customer submits cart via public page
        allow delete: if false;
      }

      // Products — public read for V-Checkout product browsing
      match /products/{pId} {
        allow read: if true;
        allow write: if request.auth != null && isAdminOrAnalyst();
      }

      match /retailers/{rId} {
        allow read: if request.auth != null && (isAdminOrAnalyst() || (hasRole('retailer') && getLinkedId() == rId));
        allow write: if request.auth != null && isAdminOrAnalyst();
        
        match /{subcollection=**} {
          allow read, write: if request.auth != null && (isAdminOrAnalyst() || (hasRole('retailer') && getLinkedId() == rId));
        }
      }
      
      match /manufacturers/{mId} {
        allow read: if request.auth != null && (isAdminOrAnalyst() || (hasRole('manufacturer') && getLinkedId() == mId));
        allow write: if request.auth != null && isAdminOrAnalyst();
      }
      
      match /salesOrders/{soId} {
        allow read: if request.auth != null && (
          isAdminOrAnalyst() ||
          (hasRole('retailer') && resource.data.retailerId == getLinkedId()) ||
          (hasRole('manufacturer') && resource.data.manufacturerId == getLinkedId())
        );
        allow update: if request.auth != null && (isAdminOrAnalyst() || (hasRole('manufacturer') && resource.data.manufacturerId == getLinkedId()));
        allow create, delete: if request.auth != null && isAdminOrAnalyst();
      }
      
      match /orders/{oId} {
        allow read: if request.auth != null && (
          isAdminOrAnalyst() || 
          (hasRole('retailer') && resource.data.retailerId == getLinkedId())
        );
        allow write: if request.auth != null && isAdminOrAnalyst();
      }
      
      match /onlineOrders/{orderId} {
        allow read, write: if request.auth != null && isAdminOrAnalyst();
      }

      // ─── Finance operations (HighRadius-style O2C + S2P) ──────────────────
      // The ledger (glAccounts, journalEntries) and party balances are owned by
      // Cloud Functions (Admin SDK bypasses these rules). Clients read, never
      // write. NOTE: full DB-level enforcement also requires retiring the
      // permissive `match /{document=**}` catch-all at the bottom of this file
      // (a tracked hardening step) — until then these write:false rules express
      // intent and bind once the catch-all is removed.

      // Chart of accounts — Function-written only.
      match /glAccounts/{acctId} {
        allow read: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst();
        allow write: if false;
      }

      // Double-entry journal — Function-written only.
      match /journalEntries/{entryId} {
        allow read: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst();
        allow write: if false;
      }

      // Unified party master. Staff manage master + credit fields; the
      // arBalance / apBalance fields are Function-owned and must not change on a
      // client write. Linked retailer/manufacturer portals may read their own.
      match /accounts/{accountId} {
        allow read: if request.auth != null && (
          (getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst()) ||
          (hasRole('retailer') && getLinkedId() == accountId) ||
          (hasRole('manufacturer') && getLinkedId() == accountId)
        );
        allow create: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst()
          && request.resource.data.arBalance == 0 && request.resource.data.apBalance == 0;
        allow update: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst()
          && request.resource.data.arBalance == resource.data.arBalance
          && request.resource.data.apBalance == resource.data.apBalance;
        allow delete: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst();
      }

      // Operational finance documents — staff CRUD; Functions post the matching
      // journal entries. These are source docs, not the ledger itself.
      match /bills/{billId}             { allow read, write: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst(); }
      match /payments/{paymentId}       { allow read, write: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst(); }
      match /cashApplications/{caId}    { allow read, write: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst(); }
      match /bankAccounts/{baId}        { allow read, write: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst(); }
      match /creditReviews/{crId}       { allow read, write: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst(); }
      match /collectionActivities/{aId} { allow read, write: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst(); }
      match /promiseToPay/{ptpId}       { allow read, write: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst(); }
      match /disputes/{dId}             { allow read, write: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst(); }
      match /promotions/{pId}           { allow read, write: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst(); }
      match /promotionClaims/{pcId}     { allow read, write: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst(); }
      match /contracts/{cId}            { allow read, write: if request.auth != null && getUserData() != null && getUserData().tenantId == tenantId && isAdminOrAnalyst(); }

      match /settings/rolePermissions {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid != null && isAdminOrAnalyst();
      }
    }
    
    // Fallback: Default allow all for backward compatibility where needed, but log warning in our minds
    // We keep this to ensure we don't accidentally block the user out of their existing schemas
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
