# ─────────────────────────────────────────────────────────────────────────────
# KrishiDukan V2 — Environment Variables Template
#
# Copy to .env.local for PRODUCTION local dev:
#   cp .env.example .env.local
#
# For UAT local dev use .env.uat (already configured), or:
#   npm run dev:uat
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://krishidukan.com

# ─── Firebase Client SDK ─────────────────────────────────────────────────────
# These NEXT_PUBLIC_* values are sent to the browser — they are NOT secret.
# Firebase API keys are restricted by domain in Firebase Console.
# PRODUCTION values:
NEXT_PUBLIC_FIREBASE_PROJECT_ID=krishidukan-e8315
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDh_Y67TDJc2KLLJ8Wcc2JvEeHzmfVL778
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=krishidukan-e8315.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=krishidukan-e8315.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=650303885415
NEXT_PUBLIC_FIREBASE_APP_ID=1:650303885415:web:7db7619260aa478b2b84c2
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-7MEFGCD4EX

# ─── Firebase Admin SDK ──────────────────────────────────────────────────────
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=krishidukan-e8315
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@krishidukan-e8315.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Razorpay ────────────────────────────────────────────────────────────────
# Use rzp_test_* keys locally; rzp_live_* keys are set in apphosting.yaml
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_SmPxtEcNJ25LUj
RAZORPAY_KEY_ID=rzp_test_SmPxtEcNJ25LUj
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ─── Google Maps ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyDh_Y67TDJc2KLLJ8Wcc2JvEeHzmfVL778

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# For Gmail: enable 2FA then generate an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=KrishiDukan <your-gmail@gmail.com>

# Inbox that receives support/contact form notifications.
# Defaults to SMTP_USER if not set.
SUPPORT_EMAIL=support@yourdomain.com

# ─── Cron / Weekly Reports ───────────────────────────────────────────────────
CRON_SECRET=change-this-to-a-strong-random-secret
NEXT_PUBLIC_CRON_SECRET=change-this-to-a-strong-random-secret
