# Public site URL (no trailing slash). Used for manufacturer → retailer invite links (?view=signup&inviteCode=).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Firebase Admin SDK — required for server-side invite lookup (/api/invite/lookup).
# Download a service account key from Firebase Console > Project Settings > Service Accounts.
FIREBASE_PROJECT_ID=krishidukan-e8315
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@krishidukan-e8315.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# For Gmail: enable 2FA then generate an App Password at myaccount.google.com/apppasswords
# For SendGrid SMTP: host=smtp.sendgrid.net port=587 user=apikey pass=<SG.xxx>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=KrishiDukan <your-gmail@gmail.com>

# ─── Cron / Weekly Reports ───────────────────────────────────────────────────
# Protects POST /api/cron/weekly-reports — must match the x-cron-secret header
CRON_SECRET=change-this-to-a-strong-random-secret
NEXT_PUBLIC_CRON_SECRET=change-this-to-a-strong-random-secret

# ─── Firebase Admin SDK ──────────────────────────────────────────────────────
# Required for weekly reports & cron (server-side Firestore read)
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=krishidukan-e8315
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@krishidukan-e8315.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
