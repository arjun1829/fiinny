<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>KrishiDukaan</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>KrishiDukaan</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Lets Firebase's silent APNs pushes (phone-auth verification, FCM data
	     messages) wake the app in the background. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>KrishiDukan uses your location to show nearby agri stores, calculate delivery availability, and give directions to dealers.</string>
	<!-- Required by App Store review (ITMS-90683) even though the app only ever
	     requests when-in-use authorization: the bundled geolocator SDK links the
	     always-authorization API, and Apple mandates a purpose string for any
	     referenced sensitive API regardless of whether it is called. The wording
	     matches the when-in-use string because that is genuinely all the app does
	     — location is never collected in the background. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>KrishiDukan uses your location to show nearby agri stores, calculate delivery availability, and give directions to dealers.</string>
	<key>NSCameraUsageDescription</key>
	<string>KrishiDukan uses the camera to record AgriReels videos and capture product photos.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>KrishiDukan uses the microphone when you record AgriReels videos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>KrishiDukan needs photo library access so you can pick product images and videos for AgriReels.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>KrishiDukan saves images you download to your photo library.</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>mailto</string>
		<string>https</string>
		<string>http</string>
		<string>whatsapp</string>
		<string>comgooglemaps</string>
		<string>youtube</string>
	</array>
	<!-- ONE CFBundleURLTypes key only. This key was previously declared twice
	     in this dict (Firebase schemes here, bundle-id scheme further down);
	     plist duplicate keys are invalid and the LAST one silently wins at
	     parse time, so the Firebase schemes were dropped from the built app —
	     the direct cause of the PhoneAuthProvider.verifyPhoneNumber fatal
	     (EXC_BREAKPOINT) during phone login on TestFlight. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Firebase Auth phone sign-in reCAPTCHA callback: the app's
				     encoded App ID (GOOGLE_APP_ID with ':' replaced by '-').
				     All three iOS app ids registered in the Firebase project
				     are listed so a build carrying any of the configs never
				     hits the PhoneAuthProvider "register custom URL scheme"
				     fatal. Canonical app (bundle …krishidukaanApp): 883857…. -->
				<string>app-1-650303885415-ios-883857d3efb69c8b2b84c2</string>
				<string>app-1-650303885415-ios-4ba023025354cd4b2b84c2</string>
				<string>app-1-650303885415-ios-c0db03e9833fbd7e2b84c2</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.karanarjuntechnologies.KrishiDukan</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
