# ── WhatsApp Cloud API credentials (required) ──────────────────────────────────
# Generate a permanent system user token from Meta Business Manager.
# Never commit the actual token — keep it in .env (gitignored).
WA_ACCESS_TOKEN=

# Your WhatsApp Business phone number ID (from Meta Developer Console → App → WhatsApp → API Setup)
WA_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (WABA ID) — used for webhook verification and bulk ops
WA_WABA_ID=

# ── Webhook ─────────────────────────────────────────────────────────────────────
# Secret token you choose — must match the value you set in Meta Developer Console
# (Webhook → Configure → Verify Token)
WA_WEBHOOK_VERIFY_TOKEN=

# Port the webhook HTTP server listens on (default: 3000)
# On Cloud Run this should match the container port in the service config
WEBHOOK_PORT=3000

# ── Firebase ────────────────────────────────────────────────────────────────────
# Optional — defaults to krishidukan-e8315
# FIREBASE_PROJECT_ID=krishidukan-e8315

# Auth is handled via Application Default Credentials (ADC).
# Local dev  → run once: gcloud auth application-default login
# Google Cloud → ADC is injected automatically via the attached service account

# ── Template settings ───────────────────────────────────────────────────────────
# Language code for all outgoing templates — must match what is approved in Meta
# Business Manager. Use "en" for English, "mr" for Marathi.
WA_TEMPLATE_LANGUAGE=mr

# ── Queue tuning ────────────────────────────────────────────────────────────────
# How often to poll Firestore for pending notifications (minutes, default: 1)
POLL_INTERVAL_MINUTES=1

# Max notifications to process per poll cycle (default: 10)
BATCH_SIZE=10
