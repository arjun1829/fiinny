rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Auth helpers ────────────────────────────────────────────────────────

    function isAuthed() {
      return request.auth != null;
    }

    // Resolve the caller's normalized phone from uidIndex.
    // Costs 1 cached read per rule evaluation — only call this for
    // collections that truly need phone-based identity.
    function hasPhone() {
      return exists(/databases/$(database)/documents/uidIndex/$(request.auth.uid));
    }

    function myPhone() {
      return hasPhone() ? get(/databases/$(database)/documents/uidIndex/$(request.auth.uid)).data.phone : '';
    }

    function hasUserDoc() {
      return myPhone() != '' && exists(/databases/$(database)/documents/users/$(myPhone()));
    }

    // Returns caller's role, or '' if missing or not resolved.
    // E.g., 'retailer', 'manufacturer', 'admin', 'customer', etc.
    function myRole() {
      return hasUserDoc() ? get(/databases/$(database)/documents/users/$(myPhone())).data.role : '';
    }

    // Direct admin check for email-based admin accounts that have no uidIndex entry.
    // Reads users/{uid} (UID used as doc ID by promoteToAdmin).
    function isDirectAdmin() {
      return isAuthed()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // isAdmin() works for both phone-based admins (via myRole) and
    // email-based admins whose doc lives at users/{uid} (via isDirectAdmin).
    function isAdmin() {
      return isDirectAdmin() || (isAuthed() && myRole() == 'admin');
    }

    // Compares a stored phone value against the caller's phone (myPhone()),
    // handling both E164 (+919876543210) and 10-digit (9876543210) formats.
    // This is the fix for the invite-acceptance "Missing or insufficient permissions" error:
    // retailerDocId is stored as a 10-digit phone, but myPhone() returns E164.
    function phoneMatches(storedPhone) {
      return storedPhone == myPhone() ||
             storedPhone == myPhone().replace('+91', '') ||
             ('+91' + storedPhone) == myPhone();
    }

    // ─── uidIndex ────────────────────────────────────────────────────────────
    // Maps Firebase Auth UID → normalized phone. Written once on first login.
    // Rule deliberately avoids myPhone() to break the bootstrap chicken-and-egg.
    match /uidIndex/{uid} {
      allow read:   if isAuthed() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthed() && request.auth.uid == uid
                       && request.resource.data.keys().hasAll(['phone', 'createdAt'])
                       && request.resource.data.phone is string;
      allow update, delete: if isAdmin();
    }

    // ─── users/{phone} ───────────────────────────────────────────────────────
    // Document ID = normalized phone e.g. "+919876543210"
    match /users/{phone} {
      allow read: if isAuthed() && (
        isAdmin() ||
        request.auth.uid == phone ||
        myPhone() == phone || myRole() in ['retailer', 'manufacturer'] ||
        // Allow first-time phone-auth login to read their pre-created doc before uidIndex exists.
        // request.auth.token.phone_number is the E.164 number from the Firebase auth JWT.
        request.auth.token.phone_number == phone
      );
      allow create: if isAdmin()
                       || (isAuthed()
                       && myPhone() == phone
                       && request.resource.data.role in ['customer', 'consumer', 'retailer', 'manufacturer']);
      allow update: if isAdmin() || (isAuthed() && (
          request.auth.uid == phone ||
          myPhone() == phone ||
          // Allow linking uid on first login before uidIndex is bootstrapped.
          request.auth.token.phone_number == phone
        ) &&
        // Prevent role downgrade
        !(
          (resource.data.role == 'retailer'     && request.resource.data.role == 'customer') ||
          (resource.data.role == 'retailer'     && request.resource.data.role == 'consumer') ||
          (resource.data.role == 'manufacturer' && request.resource.data.role in ['customer','consumer','retailer'])
        )
      );
      allow delete: if isAdmin();
    }

    // ─── profiles/{phone} ────────────────────────────────────────────────────
    // Business profile — public read, owner write.
    match /profiles/{phone} {
      allow read: if true;
      allow create: if isAdmin() || (isAuthed() && myPhone() == phone);
      allow update: if isAdmin() || (isAuthed() && myPhone() == phone)
                       || (isAuthed() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalReviews', 'averageRating']));
      allow delete: if isAdmin();
    }

    // ─── catalog ─────────────────────────────────────────────────────────────
    // Master product catalog (new schema). Public read.
    match /catalog/{catalogId} {
      allow read: if true;
      allow create: if isAuthed() && myRole() in ['retailer', 'manufacturer', 'admin']
                       && request.resource.data.createdByPhone == myPhone();
      allow update: if isAdmin() || (isAuthed() && resource.data.createdByPhone == myPhone())
                       || (isAuthed() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalReviews', 'averageRating']));
      allow delete: if isAdmin() || (isAuthed() && resource.data.createdByPhone == myPhone());
    }

    // ─── listings ────────────────────────────────────────────────────────────
    // Seller-specific offer of a catalog item (new schema). Public read.
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isAuthed() && (
        (myRole() in ['retailer', 'manufacturer'] && request.resource.data.sellerPhone == myPhone()) ||
        (myRole() == 'manufacturer' && request.resource.data.assignedByManufacturerPhone == myPhone()) ||
        isAdmin()
      );
      allow update: if isAdmin() || (isAuthed() && (
        resource.data.sellerPhone == myPhone() ||
        resource.data.assignedByManufacturerPhone == myPhone()
      ));
      allow delete: if isAdmin() || (isAuthed() && (
        resource.data.sellerPhone == myPhone() ||
        resource.data.assignedByManufacturerPhone == myPhone()
      ));
    }

    // ─── manufacturerNetwork ─────────────────────────────────────────────────
    // Manufacturer ↔ Retailer links (new schema).
    match /manufacturerNetwork/{docId} {
      allow get: if isAdmin() || (isAuthed() && (
        resource.data.manufacturerPhone == myPhone() ||
        resource.data.retailerPhone == myPhone()
      ));
      allow list: if isAuthed();
      allow create: if isAuthed() && (
        request.resource.data.manufacturerPhone == myPhone() || isAdmin()
      );
      allow update: if isAdmin() || (isAuthed() && (
        resource.data.manufacturerPhone == myPhone() ||
        (
          resource.data.status == 'invited' &&
          resource.data.claimable == true &&
          request.resource.data.status == 'active' &&
          request.resource.data.retailerPhone == myPhone() &&
          request.resource.data.claimable == false
        )
      ));
      allow delete: if isAdmin() || (
        isAuthed() && resource.data.manufacturerPhone == myPhone()
      );
    }

    // ─── seatListings ────────────────────────────────────────────────────────
    // Seat consumption tracking (new schema).
    match /seatListings/{docId} {
      allow read: if isAuthed() && (
        resource.data.ownerPhone == myPhone() || isAdmin()
      );
      allow create: if isAuthed() && (
        request.resource.data.ownerPhone == myPhone() || isAdmin()
      );
      allow update: if isAdmin() || (isAuthed() && resource.data.ownerPhone == myPhone());
      allow delete: if isAdmin();
    }

    // ─── subscriptions ───────────────────────────────────────────────────────
    // Accepts both new (ownerPhone) and legacy (ownerId) field names.
    match /subscriptions/{docId} {
      allow read: if isAuthed() && (
        (resource.data.ownerPhone is string && resource.data.ownerPhone == myPhone()) ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthed() && (
        (request.resource.data.ownerPhone is string && request.resource.data.ownerPhone == myPhone()) ||
        request.resource.data.ownerId == request.auth.uid ||
        isAdmin()
      ) && request.resource.data.ownerType in ['retailer', 'manufacturer'];
      allow update, delete: if isAdmin();
    }

    // ─── payments ────────────────────────────────────────────────────────────
    // Accepts both new (userPhone) and legacy (userId) field names.
    match /payments/{paymentId} {
      allow read: if isAuthed() && (
        (resource.data.userPhone is string && resource.data.userPhone == myPhone()) ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthed() && (
        (request.resource.data.userPhone is string && request.resource.data.userPhone == myPhone()) ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ─── failedPayments ──────────────────────────────────────────────────────
    match /failedPayments/{paymentId} {
      allow read: if isAdmin();
      allow create: if isAuthed() && (
        (request.resource.data.userPhone is string && request.resource.data.userPhone == myPhone()) ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ─── orders ──────────────────────────────────────────────────────────────
    // Accepts both new (customerPhone/sellerPhone) and legacy (customerId/sellerId) fields.
    match /orders/{orderId} {
      allow create: if isAuthed() && (
        request.resource.data.customerPhone == myPhone() ||
        request.resource.data.customerId == request.auth.uid
      ) && request.resource.data.status == 'placed'
        && request.resource.data.sellerType in ['retailer', 'manufacturer'];

      allow read: if isAdmin() || (isAuthed() && (
        resource.data.customerPhone == myPhone() ||
        resource.data.sellerPhone == myPhone() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      ));

      allow update: if isAdmin() || (isAuthed() && (
        resource.data.sellerPhone == myPhone() ||
        resource.data.sellerId == request.auth.uid
      ) && request.resource.data.status in ['placed','accepted','out_for_delivery','delivered','rejected'])
        // Allow customer to update payment field on their own order
        || (isAuthed() && (
          resource.data.customerId == request.auth.uid ||
          resource.data.customerPhone == myPhone()
        ) && request.resource.data.keys().hasOnly(['payment', 'updatedAt']));
    }

    // ─── hubs ────────────────────────────────────────────────────────────────
    match /hubs/{hubId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── adminLogs ───────────────────────────────────────────────────────────
    match /adminLogs/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── Phone-keyed subcollections ──────────────────────────────────────────
    // These are write-through mirrors of global collections, scoped by phone.
    // Global collections remain the source of truth.

    match /manufacturers/{mPhone}/retailers/{rPhone} {
    // Public list/count — needed for brand page retailer count (unauthenticated visitors).
      // Individual doc reads still restricted to the manufacturer or the retailer themselves.
      allow list: if true;
      allow get: if isAuthed() && (isAdmin() || myPhone() == mPhone || myPhone() == rPhone);
      // Manufacturer reads their roster; retailer reads their own entry.
      allow read: if isAuthed() && (isAdmin() || myPhone() == mPhone || myPhone() == rPhone);
      // Manufacturer manages their roster; retailer can update their own entry
      // (e.g. backfill sets status:"active" after onboarding).
      allow write: if isAuthed() && (myPhone() == mPhone || myPhone() == rPhone || isAdmin());
    }

    match /manufacturers/{mPhone}/products/{pid} {
      allow read: if isAuthed() && (myPhone() == mPhone || isAdmin());
      allow write: if isAuthed() && (myPhone() == mPhone || isAdmin());
    }

    match /manufacturers/{mPhone}/inventory/{iid} {
      allow read: if isAuthed() && (myPhone() == mPhone || isAdmin());
      allow write: if isAuthed() && (myPhone() == mPhone || isAdmin());
    }

    match /retailers/{rPhone}/products/{pid} {
      // Public read — product summaries are no more sensitive than the global products collection.
      // Enables efficient "retailer profile" queries without scanning all products.
      allow read: if true;
      allow write: if isAuthed() && (myPhone() == rPhone || myRole() == 'manufacturer' || isAdmin());
    }

    match /retailers/{rPhone}/inventory/{iid} {
      allow read: if isAuthed() && (myPhone() == rPhone || myRole() == 'manufacturer' || isAdmin());
      allow write: if isAuthed() && (myPhone() == rPhone || myRole() == 'manufacturer' || isAdmin());
    }

    // ─── businessCodes ───────────────────────────────────────────────────────
    // Sequential counters for human-readable identifiers (future use).
    match /businessCodes/{type} {
      allow read: if isAuthed();
      allow update: if isAuthed()
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seq', 'updatedAt']);
    }

    // ════════════════════════════════════════════════════════════════════════
    // LEGACY COLLECTIONS
    // The code still reads/writes these while migrating to the new schema.
    // Rules here use request.auth.uid directly — no myPhone() dependency —
    // so they work even before uidIndex exists.
    // ════════════════════════════════════════════════════════════════════════

    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthed();
      allow update: if isAdmin() || (isAuthed() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.retailerId == request.auth.uid ||
        resource.data.manufacturerId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        phoneMatches(resource.data.ownerId) ||
        phoneMatches(resource.data.retailerId) ||
        phoneMatches(resource.data.manufacturerId) ||
        phoneMatches(resource.data.retailerDocId) ||
        // Allow claiming assigned product if it matches the user's retailerDocId (from invite or admin assignment)
        ((resource.data.source == 'manufacturer_assigned' || resource.data.source == 'admin_assigned') && resource.data.retailerDocId != null && request.resource.data.retailerId == request.auth.uid) ||
        // Allow any retailer to add their store to the product's availability array
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availability', 'updatedAt']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availability']) ||
        // Allow owner to update discount mirror fields (effectiveDiscountPct, maxDiscountPct, availability+discount)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['effectiveDiscountPct', 'updatedAt']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['maxDiscountPct']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availability', 'updatedAt', 'effectiveDiscountPct'])
      ));
      allow delete: if isAdmin() || (isAuthed() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.manufacturerId == request.auth.uid ||
        phoneMatches(resource.data.ownerId) ||
        phoneMatches(resource.data.manufacturerId)
      ));
    }

    match /retailers/{retailerId} {
      allow read: if true;
      allow create: if isAuthed();
      allow update: if isAdmin() || (isAuthed() && (
        resource.data.userId == request.auth.uid ||
        resource.data.retailerId == request.auth.uid ||
        retailerId == request.auth.uid ||
        resource.data.phone == myPhone() ||
        resource.data.phone == myPhone().replace('+91', '') ||
        resource.data.manufacturerId == request.auth.uid ||
        resource.data.manufacturerPhone == myPhone()
      ));
      allow delete: if isAdmin() || (isAuthed() && retailerId == request.auth.uid);
    }

    match /stores/{storeId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    match /manufacturers/{manufacturerId} {
      allow read: if true;
      // Allow write when manufacturerId is the auth UID (legacy) OR the caller's phone (new schema), or admin
      allow create, update: if isAdmin() || (isAuthed() && (
        request.auth.uid == manufacturerId || myPhone() == manufacturerId
      ));
      allow delete: if isAdmin() || (isAuthed() && (
        request.auth.uid == manufacturerId || myPhone() == manufacturerId
      ));
    }
    
       // ─── brandPages/{manufacturerPhone} ─────────────────────────────────────
    // Optional brand-page customization — public read, manufacturer owner write.
    // Doc ID = manufacturerPhone (matches manufacturers/{phone}).
    match /brandPages/{manufacturerPhone} {
      allow read: if true;
      allow create, update: if isAuthed() && (myPhone() == manufacturerPhone || isAdmin());
      allow delete: if isAdmin();
    }
    
    // ─── Discount field validation helper ───────────────────────────────────
    // Returns true when the incoming write does not set invalid discount values.
    // discountPct must be 0–99; dates must be absent or timestamps.
    // Also validates new fields: discountType, discountFixedAmt, bulk tiers.
    function discountFieldsValid() {
      let d = request.resource.data;
      return (
        // discountPct: absent, or a number in [0, 99]
        (!('discountPct' in d) || (d.discountPct is number && d.discountPct >= 0 && d.discountPct <= 99)) &&
        // discountFixedAmt: absent, or a non-negative number
        (!('discountFixedAmt' in d) || (d.discountFixedAmt is number && d.discountFixedAmt >= 0)) &&
        // discountType: absent, or one of the valid values
        (!('discountType' in d) || d.discountType in ['percentage', 'fixed_amount']) &&
        // discountEnabled: absent or bool
        (!('discountEnabled' in d) || d.discountEnabled is bool) &&
        // bulkDiscountEnabled: absent or bool
        (!('bulkDiscountEnabled' in d) || d.bulkDiscountEnabled is bool) &&
        // bulkDiscountTiers: absent or list
        (!('bulkDiscountTiers' in d) || d.bulkDiscountTiers is list) &&
        // date fields: absent, null, or timestamp
        (!('discountStartDate' in d) || d.discountStartDate == null || d.discountStartDate is timestamp) &&
        (!('discountEndDate'   in d) || d.discountEndDate   == null || d.discountEndDate   is timestamp)
      );
    }

    match /inventory/{inventoryId} {
      allow read: if isAdmin() || (isAuthed() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.retailerId == request.auth.uid ||
        resource.data.manufacturerId == request.auth.uid ||
        phoneMatches(resource.data.ownerId) ||
        phoneMatches(resource.data.retailerId) ||
        phoneMatches(resource.data.manufacturerId) ||
        // retailerDocId can be stored as 10-digit or E164 — match both formats
        phoneMatches(resource.data.retailerDocId) ||
        // Allow if retailerPhone is set (post-backfill) and matches caller
        (resource.data.retailerPhone is string && phoneMatches(resource.data.retailerPhone))
      ));
      allow create: if isAdmin() || (isAuthed() && discountFieldsValid());
      allow update: if isAdmin() || (isAuthed() && discountFieldsValid() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.retailerId == request.auth.uid ||
        phoneMatches(resource.data.ownerId) ||
        phoneMatches(resource.data.retailerId) ||
        // Backfill claim: retailerDocId matches caller's phone → allowed to set retailerId=uid
        (phoneMatches(resource.data.retailerDocId) && request.resource.data.retailerId == request.auth.uid) ||
        // Also allow if retailerPhone already matches (re-running backfill)
        (resource.data.retailerPhone is string && phoneMatches(resource.data.retailerPhone) && request.resource.data.retailerId == request.auth.uid)
      ));
      allow delete: if isAdmin() || (isAuthed() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.retailerId == request.auth.uid ||
        phoneMatches(resource.data.ownerId) ||
        phoneMatches(resource.data.retailerId)
      ));
    }

    match /manufacturerRetailers/{docId} {
      allow get: if isAuthed() && (
        isAdmin() ||
        resource.data.manufacturerId == request.auth.uid ||
        resource.data.manufacturerPhone == myPhone() ||
        resource.data.retailerId == request.auth.uid ||
        // Allow retailer to read their own invite by phone (for auto-accept flow)
        phoneMatches(resource.data.retailerPhone)
      );
      allow list: if true;
      allow create: if isAuthed() && (
        request.resource.data.manufacturerId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthed() && (
        resource.data.manufacturerId == request.auth.uid ||
        resource.data.manufacturerPhone == myPhone() ||
        (
          // Allow claim/takeover: phone matches (any format) OR it's a fresh phoneless invite
          (
            (resource.data.status == 'invited' && resource.data.claimable == true && resource.data.retailerId == '') ||
            phoneMatches(resource.data.retailerPhone)
          ) &&
          resource.data.status == 'invited' &&
          resource.data.claimable == true &&
          request.resource.data.status == 'active' &&
          request.resource.data.retailerId == request.auth.uid &&
          request.resource.data.claimable == false
        )
      );
      allow delete: if isAuthed() && (
        resource.data.manufacturerId == request.auth.uid ||
        resource.data.manufacturerPhone == myPhone()
      );
    }

    match /retailerSeatListings/{docId} {
      allow read: if isAdmin() || (isAuthed() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.retailerId == request.auth.uid ||
        resource.data.manufacturerId == request.auth.uid ||
        phoneMatches(resource.data.retailerDocId) ||
        // Admin-assigned listings key ownerId by the seller's phone, not their UID.
        phoneMatches(resource.data.ownerId)
      ));
      // Admin creates a seat listing on the seller's behalf at assignment time
      // (the seller is not the authed caller then), keyed by the seller's phone.
      allow create: if isAdmin() || (isAuthed() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAdmin() || (isAuthed() && (
        resource.data.ownerId == request.auth.uid ||
        // Seller releasing their own admin-assigned (phone-keyed) listing.
        phoneMatches(resource.data.ownerId) ||
        (resource.data.retailerDocId != null && phoneMatches(resource.data.retailerDocId) && request.resource.data.retailerId == request.auth.uid)
      ));
      allow delete: if isAdmin() || (isAuthed() && (
        resource.data.ownerId == request.auth.uid ||
        phoneMatches(resource.data.ownerId)
      ));
    }

    match /manufacturer_contacts/{contactId} {
      allow read: if isAuthed() && resource.data.manufacturerId == request.auth.uid;
      allow create: if isAuthed();
      allow update, delete: if isAuthed() && resource.data.manufacturerId == request.auth.uid;
    }

    match /reportLogs/{docId} {
      allow read, write: if isAdmin();
    }

    match /contactMessages/{docId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
    
       // ─── deliverySettings/{sellerPhone} ──────────────────────────────────────
    // Seller-level delivery config (online toggle, weight slabs, coverage).
    // Public read so customers/checkout can verify delivery area.
    // Write restricted to the owning seller (phone match) or admin.
    match /deliverySettings/{sellerPhone} {
      allow read: if true;
      allow create, update: if isAuthed() && (myPhone() == sellerPhone || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── companyPages ────────────────────────────────────────────────────────
    // Brand pages created by manufacturers. Public read, owner or admin write.
    match /companyPages/{companyId} {
      allow read: if true;
      allow create: if isAdmin() || (isAuthed() && myRole() == 'manufacturer');
      allow update: if isAdmin() || (isAuthed() && (
        resource.data.ownerPhone == myPhone() ||
        companyId == myPhone()
      ));
      allow delete: if isAdmin();
    }

    // ─── blogPosts ───────────────────────────────────────────────────────────
    // Public read (published posts visible to all for SEO).
    // Only admins can create, update or delete posts.
    match /blogPosts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── siteVisits ──────────────────────────────────────────────────────────
    // Daily traffic analytics — admin read, public write (create/update to log visits).
    match /siteVisits/{date} {
      allow read: if isAdmin();
      allow create, update: if true;
    }

    match /appVersion/{vId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── productReviews & storeReviews ───────────────────────────────────────
    // Public read, authenticated users can write.
    match /productReviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthed() && request.resource.data.reviewerPhone == myPhone();
      allow update, delete: if isAdmin() || (isAuthed() && resource.data.reviewerPhone == myPhone());
    }

    match /storeReviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthed() && request.resource.data.reviewerPhone == myPhone();
      allow update, delete: if isAdmin() || (isAuthed() && resource.data.reviewerPhone == myPhone());
    }

    // ─── notifications ───────────────────────────────────────────────────────
    // Written by Cloud Functions (admin SDK bypasses rules). Recipients can
    // read their own notifications and mark them read / delete them.
    match /notifications/{notifId} {
      // GET (single doc): resource.data is available — check phone directly.
      allow get: if isAdmin() || (isAuthed() && (
        phoneMatches(resource.data.recipientPhone) ||
        (resource.data.recipientPhones is list &&
          resource.data.recipientPhones.hasAny([myPhone(), myPhone().replace('+91', '')]))
      ));
      // LIST (query): resource.data is NOT available during query evaluation.
      // Allow any authenticated user — the query is always filtered by
      // `recipientPhones arrayContains <callerPhone>` so results are already scoped.
      allow list: if isAuthed();
      allow update: if isAuthed()
        && (phoneMatches(resource.data.recipientPhone) ||
            (resource.data.recipientPhones is list &&
              resource.data.recipientPhones.hasAny([myPhone(), myPhone().replace('+91', '')])))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin() || (isAuthed() && (
        phoneMatches(resource.data.recipientPhone) ||
        (resource.data.recipientPhones is list &&
          resource.data.recipientPhones.hasAny([myPhone(), myPhone().replace('+91', '')]))
      ));
      allow create: if isAdmin();
    }

    // ─── carts/{phone} ───────────────────────────────────────────────────────────
    // Shopping cart — keyed by phone (same as users/{phone}).
    // Only the cart owner or an admin may read or write.
    match /carts/{phone} {
      allow read, write: if isAdmin() || (isAuthed() && myPhone() == phone);
    }
  }
  }