rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Auth helpers ────────────────────────────────────────────────────────

    function isAuthed() {
      return request.auth != null;
    }

    // Resolve the caller's normalized phone from uidIndex.
    // Costs 1 cached read per rule evaluation — only call this for
    // collections that truly need phone-based identity.
    function hasPhone() {
      return exists(/databases/$(database)/documents/uidIndex/$(request.auth.uid));
    }

    function myPhone() {
      return hasPhone() ? get(/databases/$(database)/documents/uidIndex/$(request.auth.uid)).data.phone : '';
    }

    function hasUserDoc() {
      return myPhone() != '' && exists(/databases/$(database)/documents/users/$(myPhone()));
    }

    // Returns caller's role, or '' if missing or not resolved.
    // E.g., 'retailer', 'manufacturer', 'admin', 'customer', etc.
    function myRole() {
      return hasUserDoc() ? get(/databases/$(database)/documents/users/$(myPhone())).data.role : '';
    }

    // Direct admin check for email-based admin accounts that have no uidIndex entry.
    // Reads users/{uid} (UID used as doc ID by promoteToAdmin).
    function isDirectAdmin() {
      return isAuthed()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // isAdmin() works for both phone-based admins (via myRole) and
    // email-based admins whose doc lives at users/{uid} (via isDirectAdmin).
    function isAdmin() {
      return isDirectAdmin() || (isAuthed() && myRole() == 'admin');
    }

    // Direct sales-exec check for email-based field-team accounts whose doc
    // lives at users/{uid} (created via the admin "create user" flow, same
    // shape as email admins). Mirrors isDirectAdmin().
    function isDirectSalesExec() {
      return isAuthed()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'salesExecutive';
    }

    // isSalesExec() works for email-based execs (users/{uid}) and any
    // phone-based exec (users/{phone} via myRole). Used to gate the shared
    // dealer master + sales writes so ordinary customers cannot read/pollute them.
    function isSalesExec() {
      return isDirectSalesExec() || (isAuthed() && myRole() == 'salesExecutive');
    }

    // ─── Team accounts (limited-access admin-portal staff) ─────────────────
    // Team accounts are always email-based (users/{uid}, created via the
    // admin "Team" tab, same shape as email admins/sales-execs) — mirrors
    // isDirectAdmin()/isDirectSalesExec(). Each doc carries an
    // `adminSections: string[]` field naming which admin-portal tabs the
    // account may use; `teamHas(section)` checks membership directly on
    // that doc instead of adding a second read via myRole()/myPhone().
    function isDirectTeam() {
      return isAuthed()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'team';
    }

    function isTeam() {
      return isDirectTeam();
    }

    function teamSections() {
      return isDirectTeam()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminSections
        : [];
    }

    // True only for a team account granted [section]. Never true for admins —
    // callers should write `isAdmin() || teamHas('x')`, not rely on this alone.
    function teamHas(section) {
      return isTeam() && (section in teamSections());
    }

    // Compares a stored phone value against the caller's phone (myPhone()),
    // handling both E164 (+919876543210) and 10-digit (9876543210) formats.
    // This is the fix for the invite-acceptance "Missing or insufficient permissions" error:
    // retailerDocId is stored as a 10-digit phone, but myPhone() returns E164.
    //
    // replace() takes an RE2 regex, so the prefix is '^[+]91'. It was written
    // as '+91' — an invalid pattern ('+' with nothing to repeat) that made that
    // clause throw on every evaluation. It failed closed (an erroring `||`
    // branch counts as false), so nothing was ever over-permitted; the owner's
    // own alternate phone format was just silently denied.
    function phoneMatches(storedPhone) {
      return storedPhone == myPhone() ||
             storedPhone == myPhone().replace('^[+]91', '') ||
             ('+91' + storedPhone) == myPhone() ||
             storedPhone == ('+91' + myPhone());
    }

    // ─── uidIndex ────────────────────────────────────────────────────────────
    // Maps Firebase Auth UID → normalized phone. Written once on first login.
    // Rule deliberately avoids myPhone() to break the bootstrap chicken-and-egg.
    match /uidIndex/{uid} {
      allow read:   if isAuthed() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthed() && request.auth.uid == uid
                       && request.resource.data.keys().hasAll(['phone', 'createdAt'])
                       && request.resource.data.phone is string;
      allow update, delete: if isAdmin();
    }

    // ─── users/{phone} ───────────────────────────────────────────────────────
    // Document ID = normalized phone e.g. "+919876543210"
    match /users/{phone} {
      allow read: if isAuthed() && (
        isAdmin() ||
        // Team members granted "users" need to list/browse every account to
        // monitor status and send pending-signup reminders.
        teamHas('users') ||
        request.auth.uid == phone ||
        myPhone() == phone || myRole() in ['retailer', 'manufacturer'] ||
        // Allow first-time phone-auth login to read their pre-created doc before uidIndex exists.
        // request.auth.token.phone_number is the E.164 number from the Firebase auth JWT.
        request.auth.token.phone_number == phone
      );
      allow create: if isAdmin()
                       || (isAuthed()
                       && myPhone() == phone
                       && request.resource.data.role in ['customer', 'consumer', 'retailer', 'manufacturer']);
      allow update: if isAdmin() || (isAuthed() && (
          request.auth.uid == phone ||
          myPhone() == phone ||
          // Allow linking uid on first login before uidIndex is bootstrapped.
          request.auth.token.phone_number == phone
        ) &&
        // Prevent role downgrade
        !(
          (resource.data.role == 'retailer'     && request.resource.data.role == 'customer') ||
          (resource.data.role == 'retailer'     && request.resource.data.role == 'consumer') ||
          (resource.data.role == 'manufacturer' && request.resource.data.role in ['customer','consumer','retailer'])
        )
      );
      allow delete: if isAdmin();
    }

    // ─── profiles/{phone} ────────────────────────────────────────────────────
    // Business profile — public read, owner write.
    match /profiles/{phone} {
      allow read: if true;
      allow create: if isAdmin() || (isAuthed() && myPhone() == phone);
      allow update: if isAdmin() || (isAuthed() && myPhone() == phone)
                       || (isAuthed() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalReviews', 'averageRating']));
      allow delete: if isAdmin();
    }

    // ─── payoutAccounts ──────────────────────────────────────────────────────
    // Seller bank details for order payouts. The ONLY collection in this file
    // that is neither public nor role-readable, and it must stay that way:
    //   - profiles/{phone} is `allow read: if true`
    //   - users/{phone} is readable by any retailer or manufacturer
    // so bank details in either of those would be visible platform-wide.
    // Owner and admin only — no teamHas(), no role checks, no exceptions.
    match /payoutAccounts/{phone} {
      allow read:   if isAuthed() && (isAdmin() || myPhone() == phone);

      // A seller may submit their own details, but NEVER the fields that
      // decide whether they get paid. `update` used to allow the owner to
      // write any field, which meant a seller could set their own
      // status:'verified' — harmless while nothing read it, but this gates
      // real payouts now. Verification fields are admin-only; a seller
      // touching them is rejected outright rather than silently ignored.
      allow create: if isAuthed() && myPhone() == phone
                    && payoutStatusOk()
                    && !request.resource.data.keys().hasAny(payoutProtectedFields());
      allow update: if isAdmin()
                    || (isAuthed() && myPhone() == phone
                        && payoutStatusOk()
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(payoutProtectedFields()));
      // Never client-deletable — payout history must stay auditable.
      allow delete: if false;
    }

    // ─── catalog ─────────────────────────────────────────────────────────────
    // Master product catalog (new schema). Public read.
    match /catalog/{catalogId} {
      allow read: if true;
      allow create: if isAuthed() && myRole() in ['retailer', 'manufacturer', 'admin']
                       && request.resource.data.createdByPhone == myPhone();
      allow update: if isAdmin() || (isAuthed() && resource.data.createdByPhone == myPhone())
                       || (isAuthed() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalReviews', 'averageRating']));
      allow delete: if isAdmin() || (isAuthed() && resource.data.createdByPhone == myPhone());
    }

    // ─── listings ────────────────────────────────────────────────────────────
    // Seller-specific offer of a catalog item (new schema). Public read.
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isAuthed() && (
        (myRole() in ['retailer', 'manufacturer'] && request.resource.data.sellerPhone == myPhone()) ||
        (myRole() == 'manufacturer' && request.resource.data.assignedByManufacturerPhone == myPhone()) ||
        isAdmin()
      );
      allow update: if isAdmin() || (isAuthed() && (
        resource.data.sellerPhone == myPhone() ||
        resource.data.assignedByManufacturerPhone == myPhone()
      ));
      allow delete: if isAdmin() || (isAuthed() && (
        resource.data.sellerPhone == myPhone() ||
        resource.data.assignedByManufacturerPhone == myPhone()
      ));
    }

    // ─── manufacturerNetwork ─────────────────────────────────────────────────
    // Manufacturer ↔ Retailer links (new schema).
    match /manufacturerNetwork/{docId} {
      allow get: if isAdmin() || (isAuthed() && (
        resource.data.manufacturerPhone == myPhone() ||
        resource.data.retailerPhone == myPhone()
      ));
      allow list: if isAuthed();
      allow create: if isAuthed() && (
        request.resource.data.manufacturerPhone == myPhone() || isAdmin()
      );
      allow update: if isAdmin() || (isAuthed() && (
        resource.data.manufacturerPhone == myPhone() ||
        (
          resource.data.status == 'invited' &&
          resource.data.claimable == true &&
          request.resource.data.status == 'active' &&
          request.resource.data.retailerPhone == myPhone() &&
          request.resource.data.claimable == false
        )
      ));
      allow delete: if isAdmin() || (
        isAuthed() && resource.data.manufacturerPhone == myPhone()
      );
    }

    // ─── seatListings ────────────────────────────────────────────────────────
    // Seat consumption tracking (new schema).
    match /seatListings/{docId} {
      allow read: if isAuthed() && (
        resource.data.ownerPhone == myPhone() || isAdmin()
      );
      allow create: if isAuthed() && (
        request.resource.data.ownerPhone == myPhone() || isAdmin()
      );
      allow update: if isAdmin() || (isAuthed() && resource.data.ownerPhone == myPhone());
      allow delete: if isAdmin();
    }

    // ─── subscriptions ───────────────────────────────────────────────────────
    // Accepts both new (ownerPhone) and legacy (ownerId) field names.
    match /subscriptions/{docId} {
      // teamHas('users') covers the admin "view seller's dashboard" link in
      // Users & Roles (app/dashboard/layout.tsx's admin-impersonation path) —
      // without it, a team member landed on the dashboard but every read
      // still denied since they aren't the seller and aren't a full admin.
      allow read: if isAuthed() && (
        (resource.data.ownerPhone is string && resource.data.ownerPhone == myPhone()) ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin() || teamHas('users')
      );
      allow create: if isAuthed() && (
        (request.resource.data.ownerPhone is string && request.resource.data.ownerPhone == myPhone()) ||
        request.resource.data.ownerId == request.auth.uid ||
        isAdmin()
      ) && request.resource.data.ownerType in ['retailer', 'manufacturer'];
      allow update, delete: if isAdmin();
    }

    // ─── plans ───────────────────────────────────────────────────────────────
    // Admin-configurable subscription plan templates. Public read (a future
    // self-checkout page can list active plans without a server round-trip);
    // all writes go through app/api/admin/plans/* (Firebase Admin SDK, which
    // bypasses these rules entirely) — client-side writes are denied outright
    // so plan mutations always get the server-side validation/audit-log path.
    match /plans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── settings ────────────────────────────────────────────────────────────
    // Public, non-secret configuration. settings/pricing holds the self-serve
    // subscription ladder that the checkout, SubscriptionView and /sell all read,
    // so it must be world-readable — the prices are on a public marketing page
    // anyway. Writes go through /api/admin/pricing (Admin SDK, requireAdmin,
    // adminLogs), never from a client, because this document decides what a
    // seller is charged.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // Server-only configuration (e.g. the reassignment-expiry cron secret).
    // Unlike settings/, which is public-read, no client may read or write this.
    match /_serverConfig/{docId} {
      allow read, write: if false;
    }

    // ─── promoCodes ──────────────────────────────────────────────────────────
    // Subscription discount codes. These had NO rule at all, and with no
    // catch-all match Firestore denied every read — so SubscriptionView's
    // client-side lookup always failed and every seller saw "Could not validate
    // promo code", making the feature entirely non-functional.
    //
    // Read is public because the seller must be able to validate a code before
    // paying, and a discount percentage is not a secret. It is NOT the authority
    // on the charge: api/payment/create-order re-reads this collection with the
    // Admin SDK and recomputes the amount, so a tampered client read cannot
    // change what is billed. Writes are admin-only via /api/admin/promo-codes.
    match /promoCodes/{codeId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── payments ────────────────────────────────────────────────────────────
    // Accepts both new (userPhone) and legacy (userId) field names.
    match /payments/{paymentId} {
      allow read: if isAuthed() && (
        (resource.data.userPhone is string && resource.data.userPhone == myPhone()) ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthed() && (
        (request.resource.data.userPhone is string && request.resource.data.userPhone == myPhone()) ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ─── failedPayments ──────────────────────────────────────────────────────
    // ─── paymentAttempts ──────────────────────────────────────────────────────
    // One doc per Razorpay order, written server-side by the create-order routes
    // before checkout opens, then moved to paid/failed as the payment resolves.
    //
    // NO CLIENT WRITES AT ALL. Every write goes through the Admin SDK, which
    // bypasses these rules — that is the point. This record is the evidence of
    // what a customer tried to buy and at what price, so allowing the customer
    // to create or edit it would let them forge a basket or erase a failure.
    // Clients report a failure through /api/payment/attempt-failed instead,
    // which re-checks Razorpay before believing them.
    //
    // Reads are admin-only: an attempt row exposes the buyer's phone alongside
    // the priced basket.
    match /paymentAttempts/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── sellerOffers ─────────────────────────────────────────────────────────
    // Reassignment offers: an order another seller rejected, offered to this
    // seller for 24h (app/lib/order-reassignment.ts). Keyed by the seller's
    // 10-digit phone in the PATH, not a field: a list rule can only be proven
    // from the path here, so a field-based rule would have to allow any
    // signed-in user to list every seller's offers. Server-written only;
    // accept/decline go through /api/orders/reassignment.
    match /sellerOffers/{sellerKey}/offers/{orderId} {
      allow read: if isAdmin() || (isAuthed() && myPhone().replace('^[+]91', '') == sellerKey);
      allow write: if false;
    }

    // ─── enquiries ────────────────────────────────────────────────────────────
    // A lost sale, fanned out to the sellers who could still win it: when a
    // checkout is abandoned or fails, the scheduled sweep in
    // functions/src/notifications/enquiries.ts writes one doc per SELLER of the
    // products involved, carrying only that seller's lines plus the buyer's
    // name and phone so they can call and follow up.
    //
    // Deliberately a separate collection from paymentAttempts: an attempt doc
    // holds every seller's lines in a multi-seller basket plus the buyer's
    // delivery address, and rules cannot filter fields — so a seller could
    // never be given read access to it directly.
    //
    // Server-writes only (the sweep uses the Admin SDK, which bypasses these
    // rules). A seller cannot forge a lead or rewrite what the buyer tried to
    // order; they may only move their own copy through its follow-up states.
    match /enquiries/{enquiryId} {
      // GET (single doc): resource.data is available — check the phone directly.
      allow get: if isAdmin() || (isAuthed() && (
        phoneMatches(resource.data.sellerPhone) ||
        (resource.data.sellerPhones is list &&
          resource.data.sellerPhones.hasAny([myPhone(), myPhone().replace('^[+]91', '')]))
      ));
      // LIST (query): resource.data is NOT available during query evaluation,
      // same as notifications — the query is always filtered by
      // `sellerPhones arrayContains <callerPhone>`, so results are already scoped.
      allow list: if isAuthed();
      allow update: if isAdmin() || (isAuthed()
        && (phoneMatches(resource.data.sellerPhone) ||
            (resource.data.sellerPhones is list &&
              resource.data.sellerPhones.hasAny([myPhone(), myPhone().replace('^[+]91', '')])))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'sellerNote', 'contactedAt', 'updatedAt']));
      allow create, delete: if false;
    }

    match /failedPayments/{paymentId} {
      allow read: if isAdmin();
      allow create: if isAuthed() && (
        (request.resource.data.userPhone is string && request.resource.data.userPhone == myPhone()) ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ─── orders ──────────────────────────────────────────────────────────────
    // Accepts both new (customerPhone/sellerPhone) and legacy (customerId/sellerId) fields.
    match /orders/{orderId} {
      allow create: if isAuthed() && (
        request.resource.data.customerPhone == myPhone() ||
        request.resource.data.customerId == request.auth.uid
      ) && request.resource.data.status == 'placed'
        && request.resource.data.sellerType in ['retailer', 'manufacturer'];

      // teamHas('users') covers the admin "view seller's dashboard" link.
      allow read: if isAdmin() || teamHas('users') || teamHas('orders') || (isAuthed() && (
        resource.data.customerPhone == myPhone() ||
        resource.data.sellerPhone == myPhone() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      ));

      // Seller status updates. Three guards beyond ownership:
      //  - Not while 'reassigning': during the 24h window the order belongs to
      //    nobody. The seller who rejected it is still sellerPhone until someone
      //    accepts, and must not be able to flip it back.
      //  - No 'rejected': rejection moves money (refund, transfer reversal,
      //    reassignment offers) and goes only through /api/orders/reject. Both
      //    apps already send it there; a bare write used to skip the refund.
      //  - Never the fields that decide who is paid or who the order belongs
      //    to — those are written only by the server.
      allow update: if isAdmin() || (isAuthed() && (
        resource.data.sellerPhone == myPhone() ||
        resource.data.sellerId == request.auth.uid
      ) && resource.data.status != 'reassigning'
        && request.resource.data.status in ['placed','accepted','dispatched','out_for_delivery','delivered']
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'reassignment', 'routeTransfer', 'routeRelease', 'payment',
          'sellerPhone', 'sellerId', 'customerId', 'customerPhone'
        ]))
        // Allow customer to update payment field on their own order
        || (isAuthed() && (
          resource.data.customerId == request.auth.uid ||
          resource.data.customerPhone == myPhone()
        ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payment', 'updatedAt']))
        // Allow customer to write invoice metadata after PDF upload
        || (isAuthed() && (
          resource.data.customerId == request.auth.uid ||
          resource.data.customerPhone == myPhone()
        ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invoice']));
    }

    // ─── hubs ────────────────────────────────────────────────────────────────
    match /hubs/{hubId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── banners ─────────────────────────────────────────────────────────────
    // Homepage hero carousel, managed from the admin Banner Management module.
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── adminLogs ───────────────────────────────────────────────────────────
    match /adminLogs/{docId} {
      allow read: if isAdmin();
      // Team accounts can write their own audit entries (so their actions —
      // reminder sends, WA replies — are still logged) but never read the
      // full log, which can reveal admin-account creation/deletion history.
      allow write: if isAdmin() || isTeam();
    }

    // ─── Phone-keyed subcollections ──────────────────────────────────────────
    // These are write-through mirrors of global collections, scoped by phone.
    // Global collections remain the source of truth.

    match /manufacturers/{mPhone}/retailers/{rPhone} {
      // Public list/count — needed for brand page retailer count (unauthenticated visitors).
      // Individual doc reads still restricted to the manufacturer or the retailer themselves.
      allow list: if true;
      allow get: if isAuthed() && (isAdmin() || myPhone() == mPhone || myPhone() == rPhone);
      // Manufacturer reads their roster; retailer reads their own entry.
      allow read: if isAuthed() && (isAdmin() || myPhone() == mPhone || myPhone() == rPhone);
      // Manufacturer manages their roster; retailer can update their own entry
      // (e.g. backfill sets status:"active" after onboarding).
      allow write: if isAuthed() && (myPhone() == mPhone || myPhone() == rPhone || isAdmin());
    }

    match /manufacturers/{mPhone}/products/{pid} {
      allow read: if isAuthed() && (myPhone() == mPhone || isAdmin());
      allow write: if isAuthed() && (myPhone() == mPhone || isAdmin());
    }

    match /manufacturers/{mPhone}/inventory/{iid} {
      allow read: if isAuthed() && (myPhone() == mPhone || isAdmin());
      allow write: if isAuthed() && (myPhone() == mPhone || isAdmin());
    }

    match /retailers/{rPhone}/products/{pid} {
      // Public read — product summaries are no more sensitive than the global products collection.
      // Enables efficient "retailer profile" queries without scanning all products.
      allow read: if true;
      allow write: if isAuthed() && (myPhone() == rPhone || myRole() == 'manufacturer' || isAdmin());
    }

    match /retailers/{rPhone}/inventory/{iid} {
      allow read: if isAuthed() && (myPhone() == rPhone || myRole() == 'manufacturer' || isAdmin());
      allow write: if isAuthed() && (myPhone() == rPhone || myRole() == 'manufacturer' || isAdmin());
    }

    // ─── businessCodes ───────────────────────────────────────────────────────
    // Sequential counters for human-readable identifiers (future use).
    match /businessCodes/{type} {
      allow read: if isAuthed();
      allow update: if isAuthed()
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seq', 'updatedAt']);
    }

    // ════════════════════════════════════════════════════════════════════════
    // LEGACY COLLECTIONS
    // The code still reads/writes these while migrating to the new schema.
    // Rules here use request.auth.uid directly — no myPhone() dependency —
    // so they work even before uidIndex exists.
    // ════════════════════════════════════════════════════════════════════════

    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthed();
      // Team members granted "products" can help a seller who can't list a
      // product themselves — same broad section-scoped grant as inventory.
      allow update: if isAdmin() || teamHas('products') || (isAuthed() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.retailerId == request.auth.uid ||
        resource.data.manufacturerId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        phoneMatches(resource.data.ownerId) ||
        phoneMatches(resource.data.retailerId) ||
        phoneMatches(resource.data.manufacturerId) ||
        phoneMatches(resource.data.retailerDocId) ||
        // Allow claiming assigned product if it matches the user's retailerDocId (from invite or admin assignment)
        ((resource.data.source == 'manufacturer_assigned' || resource.data.source == 'admin_assigned') && resource.data.retailerDocId != null && request.resource.data.retailerId == request.auth.uid) ||
        // Allow any retailer to add their store to the product's availability array
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availability', 'updatedAt']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availability']) ||
        // Allow any authed shopper to bump the analytics counters only
        // (trackProductImpression/Click/StoreCall/DirectionRequest in
        // app/firebase.ts). Without this the seller-analytics counters were
        // permission-denied for every non-owner and silently stayed zero —
        // same pattern as the reels viewsCount/likesCount clause.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'impressions', 'clicks', 'positionSum', 'calls', 'directionRequests',
          'impressionsByDay', 'clicksByDay', 'callsByDay', 'directionRequestsByDay'
        ]) ||
        // Allow owner to update discount mirror fields (effectiveDiscountPct, maxDiscountPct, availability+discount)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['effectiveDiscountPct', 'updatedAt']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['maxDiscountPct']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availability', 'updatedAt', 'effectiveDiscountPct'])
      ));
      allow delete: if isAdmin() || (isAuthed() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.manufacturerId == request.auth.uid ||
        phoneMatches(resource.data.ownerId) ||
        phoneMatches(resource.data.manufacturerId)
      ));
    }

    match /retailers/{retailerId} {
      allow read: if true;
      allow create: if isAuthed();
      // Storefront view counters: any signed-in shopper may bump these two
      // fields and nothing else, the same narrowly-scoped counter exemption
      // businessCodes uses. This is what feeds "store views" in the seller's
      // analytics screen and in the weekly/monthly/yearly digest notification
      // (collectStats in functions/src/notifications/digest.ts) — without it
      // the write is denied for every visitor except the owner, which is
      // precisely the visitor whose views must NOT be counted.
      allow update: if isAuthed()
                       && request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasOnly(['storeViews', 'storeViewsByDay']);
      allow update: if isAdmin() || (isAuthed() && (
        resource.data.userId == request.auth.uid ||
        resource.data.retailerId == request.auth.uid ||
        retailerId == request.auth.uid ||
        resource.data.phone == myPhone() ||
        resource.data.phone == myPhone().replace('^[+]91', '') ||
        resource.data.manufacturerId == request.auth.uid ||
        resource.data.manufacturerPhone == myPhone()
      ));
      allow delete: if isAdmin() || (isAuthed() && retailerId == request.auth.uid);
    }

    // Legacy store directory. Public read; writes are admin-only.
    //
    // This was `allow write: if isAuthed()`, which let any signed-in account
    // rewrite or delete any shop in the directory. The only client that ever
    // wrote here was the homepage's demo-data seeder (app/page.tsx), which has
    // been removed -- the mobile app and the storefront only read. Real store
    // records are written server-side through the Admin SDK, which bypasses
    // these rules entirely, so nothing legitimate needs client write access.
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /manufacturers/{manufacturerId} {
      allow read: if true;
      // Allow write when manufacturerId is the auth UID (legacy) OR the caller's phone (new schema), or admin
      allow create, update: if isAdmin() || (isAuthed() && (
        request.auth.uid == manufacturerId || myPhone() == manufacturerId
      ));
      allow delete: if isAdmin() || (isAuthed() && (
        request.auth.uid == manufacturerId || myPhone() == manufacturerId
      ));
    }

    // ─── brandPages/{manufacturerPhone} ─────────────────────────────────────
    // Optional brand-page customization — public read, manufacturer owner write.
    // Doc ID = manufacturerPhone (matches manufacturers/{phone}).
    match /brandPages/{manufacturerPhone} {
      allow read: if true;
      allow create, update: if isAuthed() && (myPhone() == manufacturerPhone || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── Discount field validation helper ───────────────────────────────────
    // Returns true when the incoming write does not set invalid discount values.
    // discountPct must be 0–99; dates must be absent or timestamps.
    // Also validates new fields: discountType, discountFixedAmt, bulk tiers.
    /// Fields on payoutAccounts only an admin may write — they decide whether
    /// a seller is paid, and to which Razorpay linked account. `status` is
    /// handled separately (see payoutStatusOk) because a seller legitimately
    /// sets it to 'pending_verification' when submitting or editing.
    function payoutProtectedFields() {
      return ['razorpayLinkedAccountId', 'verifiedAt', 'verifiedBy',
              'rejectionReason'];
    }

    /// A seller may only ever put their payout account INTO review, never
    /// approve it. Editing verified details correctly sends it back to
    /// pending, which is what re-submitting should do.
    function payoutStatusOk() {
      return !('status' in request.resource.data)
             || request.resource.data.status == 'pending_verification';
    }

    function discountFieldsValid() {
      let d = request.resource.data;
      return (
        // discountPct: absent, or a number in [0, 99]
        (!('discountPct' in d) || (d.discountPct is number && d.discountPct >= 0 && d.discountPct <= 99)) &&
        // discountFixedAmt: absent, or a non-negative number
        (!('discountFixedAmt' in d) || (d.discountFixedAmt is number && d.discountFixedAmt >= 0)) &&
        // discountType: absent, or one of the valid values
        (!('discountType' in d) || d.discountType in ['percentage', 'fixed_amount']) &&
        // discountEnabled: absent or bool
        (!('discountEnabled' in d) || d.discountEnabled is bool) &&
        // bulkDiscountEnabled: absent or bool
        (!('bulkDiscountEnabled' in d) || d.bulkDiscountEnabled is bool) &&
        // bulkDiscountTiers: absent or list
        (!('bulkDiscountTiers' in d) || d.bulkDiscountTiers is list) &&
        // date fields: absent, null, or timestamp
        (!('discountStartDate' in d) || d.discountStartDate == null || d.discountStartDate is timestamp) &&
        (!('discountEndDate'   in d) || d.discountEndDate   == null || d.discountEndDate   is timestamp)
      );
    }

    match /inventory/{inventoryId} {
      // Team members granted "inventory" can see/help manage any seller's
      // listing (helping a seller who can't list a product themselves) —
      // this is a deliberately broad read/write grant scoped to the section,
      // not to a specific owner.
      allow read: if isAdmin() || teamHas('inventory') || (isAuthed() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.retailerId == request.auth.uid ||
        resource.data.manufacturerId == request.auth.uid ||
        phoneMatches(resource.data.ownerId) ||
        phoneMatches(resource.data.retailerId) ||
        phoneMatches(resource.data.manufacturerId) ||
        // retailerDocId can be stored as 10-digit or E164 — match both formats
        phoneMatches(resource.data.retailerDocId) ||
        // Allow if retailerPhone is set (post-backfill) and matches caller
        (resource.data.retailerPhone is string && phoneMatches(resource.data.retailerPhone))
      ));
      allow create: if isAdmin() || teamHas('inventory') || (isAuthed() && discountFieldsValid());
      allow update: if isAdmin() || teamHas('inventory') || (isAuthed() && discountFieldsValid() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.retailerId == request.auth.uid ||
        phoneMatches(resource.data.ownerId) ||
        phoneMatches(resource.data.retailerId) ||
        // Backfill claim: retailerDocId matches caller's phone → allowed to set retailerId=uid
        (phoneMatches(resource.data.retailerDocId) && request.resource.data.retailerId == request.auth.uid) ||
        // Also allow if retailerPhone already matches (re-running backfill)
        (resource.data.retailerPhone is string && phoneMatches(resource.data.retailerPhone) && request.resource.data.retailerId == request.auth.uid)
      ));
      allow delete: if isAdmin() || (isAuthed() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.retailerId == request.auth.uid ||
        phoneMatches(resource.data.ownerId) ||
        phoneMatches(resource.data.retailerId)
      ));
    }

    match /manufacturerRetailers/{docId} {
      allow get: if isAuthed() && (
        isAdmin() ||
        resource.data.manufacturerId == request.auth.uid ||
        resource.data.manufacturerPhone == myPhone() ||
        resource.data.retailerId == request.auth.uid ||
        // Allow retailer to read their own invite by phone (for auto-accept flow)
        phoneMatches(resource.data.retailerPhone)
      );
      allow list: if true;
      allow create: if isAuthed() && (
        request.resource.data.manufacturerId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin() || (isAuthed() && (
        resource.data.manufacturerId == request.auth.uid ||
        resource.data.manufacturerPhone == myPhone() ||
        (
          // Allow claim/takeover: phone matches (any format) OR it's a fresh phoneless invite
          (
            (resource.data.status == 'invited' && resource.data.claimable == true && resource.data.retailerId == '') ||
            phoneMatches(resource.data.retailerPhone)
          ) &&
          resource.data.status == 'invited' &&
          resource.data.claimable == true &&
          request.resource.data.status == 'active' &&
          request.resource.data.retailerId == request.auth.uid &&
          request.resource.data.claimable == false
        ) ||
        // Team members (Users & Roles section) sending a pending-signup
        // reminder only ever touch these three audit fields — never status,
        // claimable, or ownership, so this can't be used to hijack an invite.
        (
          teamHas('users') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['lastReminderSentAt', 'lastReminderSentBy', 'reminderCount']
          )
        )
      ));
      allow delete: if isAdmin() || (isAuthed() && (
        resource.data.manufacturerId == request.auth.uid ||
        resource.data.manufacturerPhone == myPhone()
      ));
    }

    match /retailerSeatListings/{docId} {
      // teamHas('users') covers the admin "view seller's dashboard" link —
      // the dashboard's "Listing Seats" card needs this too.
      allow read: if isAdmin() || teamHas('users') || (isAuthed() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.retailerId == request.auth.uid ||
        resource.data.manufacturerId == request.auth.uid ||
        // Phone-keyed reads — required so the seat-stats queries that filter by
        // ownerPhone / manufacturerPhone are authorized. The dashboard "Listing
        // Seats" card depends on these; without them the query is denied and the
        // whole card silently disappears.
        resource.data.ownerPhone == myPhone() ||
        resource.data.manufacturerPhone == myPhone() ||
        phoneMatches(resource.data.retailerDocId) ||
        // Admin-assigned listings key ownerId by the seller's phone, not their UID.
        phoneMatches(resource.data.ownerId)
      ));
      // Admin creates a seat listing on the seller's behalf at assignment time
      // (the seller is not the authed caller then), keyed by the seller's phone.
      allow create: if isAdmin() || (isAuthed() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAdmin() || (isAuthed() && (
        resource.data.ownerId == request.auth.uid ||
        // Seller releasing their own admin-assigned (phone-keyed) listing.
        phoneMatches(resource.data.ownerId) ||
        (resource.data.retailerDocId != null && phoneMatches(resource.data.retailerDocId) && request.resource.data.retailerId == request.auth.uid)
      ));
      allow delete: if isAdmin() || (isAuthed() && (
        resource.data.ownerId == request.auth.uid ||
        phoneMatches(resource.data.ownerId)
      ));
    }

    match /manufacturer_contacts/{contactId} {
      allow read: if isAuthed() && resource.data.manufacturerId == request.auth.uid;
      allow create: if isAuthed();
      allow update, delete: if isAuthed() && resource.data.manufacturerId == request.auth.uid;
    }

    match /reportLogs/{docId} {
      allow read, write: if isAdmin();
    }

    match /contactMessages/{docId} {
      allow create: if true;
      allow read, write: if isAdmin() || teamHas('messages');
    }

    // ─── WhatsApp inbox ──────────────────────────────────────────────────────
    // Written by Cloud Functions / webhook (admin SDK, bypasses rules).
    // Read/write from the client restricted to admins and team members
    // granted the "whatsapp" or "users" section (the latter needs
    // waNotifications write access to queue pending-signup reminders).
    match /waIncomingMessages/{msgId} {
      allow read, write: if isAdmin() || teamHas('whatsapp');
    }

    match /waNotifications/{notifId} {
      allow read, write: if isAdmin() || teamHas('whatsapp') || teamHas('users');
    }

    match /waConversations/{phone} {
      allow read, write: if isAdmin() || teamHas('whatsapp');

      match /messages/{msgId} {
        allow read, write: if isAdmin() || teamHas('whatsapp');
      }

      match /notes/{noteId} {
        allow read, write: if isAdmin() || teamHas('whatsapp');
      }
    }

    // ─── deliverySettings/{sellerPhone} ──────────────────────────────────────
    
       // ─── deliverySettings/{sellerPhone} ──────────────────────────────────────
    // Seller-level delivery config (online toggle, weight slabs, coverage).
    // Public read so customers/checkout can verify delivery area.
    // Write restricted to the owning seller (phone match) or admin.
    match /deliverySettings/{sellerPhone} {
      allow read: if true;
      allow create, update: if isAuthed() && (myPhone() == sellerPhone || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── companyPages ────────────────────────────────────────────────────────
    // Brand pages created by manufacturers. Public read, owner or admin write.
    match /companyPages/{companyId} {
      allow read: if true;
      allow create: if isAdmin() || (isAuthed() && myRole() == 'manufacturer');
      allow update: if isAdmin() || (isAuthed() && (
        resource.data.ownerPhone == myPhone() ||
        companyId == myPhone()
      ));
      allow delete: if isAdmin();
    }

    // ─── blogPosts ───────────────────────────────────────────────────────────
    // Public read (published posts visible to all for SEO).
    // Only admins can create, update or delete posts.
    match /blogPosts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── siteVisits ──────────────────────────────────────────────────────────
    // Daily traffic analytics — admin read, public write (create/update to log visits).
    match /siteVisits/{date} {
      allow read: if isAdmin();
      allow create, update: if true;
    }

    // ─── activeUsers / mau / retention ───────────────────────────────────────
    // Analytics aggregation written by the onActiveUserPresence Cloud Function
    // (Admin SDK, bypasses rules). The client only writes presence subcollection
    // docs (trackUserActivity). Summary docs are admin-read-only.

    // Summary doc: pre-aggregated DAU count + role/device buckets.
    match /activeUsers/{date} {
      allow read: if isAdmin();
      // CF writes via Admin SDK — no client write on the summary doc.
    }
    // Presence subcollection: authenticated users write their own daily signal.
    // Doc ID is the caller's stable phone number or uid (see trackUserActivity).
    match /activeUsers/{date}/presence/{userId} {
      allow create, update: if isAuthed() && (
        request.auth.uid == userId || myPhone() == userId
      );
      allow read: if isAdmin();
    }

    // Monthly unique-user summary written by the CF.
    match /mau/{month} {
      allow read: if isAdmin();
    }
    // MAU first-seen marker written by the CF — no client access needed.
    match /mau/{month}/presence/{userId} {
      allow read: if isAdmin();
    }

    // Retention cohort summaries written by the CF.
    match /retention/{cohortDay} {
      allow read: if isAdmin();
    }
    // Retention per-window markers written by the CF — no client access needed.
    match /retention/{cohortDay}/{window}/{userId} {
      allow read: if isAdmin();
    }

    match /appVersion/{vId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── productReviews & storeReviews ───────────────────────────────────────
    // Public read, authenticated users can write.
    match /productReviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthed() && request.resource.data.reviewerPhone == myPhone();
      allow update, delete: if isAdmin() || (isAuthed() && resource.data.reviewerPhone == myPhone());
    }

    match /storeReviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthed() && request.resource.data.reviewerPhone == myPhone();
      allow update, delete: if isAdmin() || (isAuthed() && resource.data.reviewerPhone == myPhone());
    }

    // ─── notifications ───────────────────────────────────────────────────────
    // Written by Cloud Functions (admin SDK bypasses rules). Recipients can
    // read their own notifications and mark them read / delete them.
    match /notifications/{notifId} {
      // GET (single doc): resource.data is available — check phone directly.
      allow get: if isAdmin() || (isAuthed() && (
        phoneMatches(resource.data.recipientPhone) ||
        (resource.data.recipientPhones is list &&
          resource.data.recipientPhones.hasAny([myPhone(), myPhone().replace('^[+]91', '')]))
      ));
      // LIST (query): resource.data is NOT available during query evaluation.
      // Allow any authenticated user — the query is always filtered by
      // `recipientPhones arrayContains <callerPhone>` so results are already scoped.
      allow list: if isAuthed();
      allow update: if isAuthed()
        && (phoneMatches(resource.data.recipientPhone) ||
            (resource.data.recipientPhones is list &&
              resource.data.recipientPhones.hasAny([myPhone(), myPhone().replace('^[+]91', '')])))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin() || (isAuthed() && (
        phoneMatches(resource.data.recipientPhone) ||
        (resource.data.recipientPhones is list &&
          resource.data.recipientPhones.hasAny([myPhone(), myPhone().replace('^[+]91', '')]))
      ));
      allow create: if isAdmin();
    }

    // ─── carts/{phone} ───────────────────────────────────────────────────────────
    // Shopping cart — keyed by phone (same as users/{phone}).
    // Only the cart owner or an admin may read or write.
    match /carts/{phone} {
      allow read, write: if isAdmin() || (isAuthed() && myPhone() == phone);
    }

    // ─── usernames ───────────────────────────────────────────────────────────
    // Doc ID = lowercase handle (e.g. "agriking").
    // Public read for search. Only the owning seller (phone match) or admin writes.
    // Uniqueness is enforced at the doc level — a create fails if the doc already exists.
    match /usernames/{handle} {
      allow read: if true;
      allow create: if isAuthed()
        && request.resource.data.phone == myPhone()
        && myRole() in ['retailer', 'manufacturer'];
      allow update: if isAdmin()
        || (isAuthed() && resource.data.phone == myPhone());
      allow delete: if isAdmin()
        || (isAuthed() && resource.data.phone == myPhone());
    }

    // ─── reels ───────────────────────────────────────────────────────────────
    // Public read. Any authenticated user can create their own reel; admin can
    // also create a reel on behalf of any seller (web admin "upload for seller"
    // flow, e.g. when the seller can't upload it themselves).
    // Only the shop owner (matched by phone) or admin can update/delete.
    // viewsCount increment is the only anonymous-adjacent write, but we keep
    // write gated on auth to prevent abuse — unauthenticated viewers still
    // generate a view event because the mobile calls incrementViewsCount only
    // after the user has the app open (implying phone auth).
    match /reels/{reelId} {
      allow read: if true;
      allow create: if isAdmin()
        || (isAuthed() && request.resource.data.shopOwnerId == myPhone());
      allow update: if isAdmin()
        // The owner can edit their own reel, but not moderationStatus or
        // reportCount — those exist so a report can't be reversed by the
        // person being reported. Only flagReelOnReports (admin SDK, bypasses
        // rules entirely) or an admin may touch them.
        || (isAuthed() && phoneMatches(resource.data.shopOwnerId)
              && !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['moderationStatus', 'reportCount']))
        // Allow any authed user to increment the counter fields only
        // (likesCount via toggleLike, commentsCount via addComment, viewsCount via incrementViewsCount)
        || (isAuthed() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['viewsCount', 'likesCount', 'commentsCount']));
      allow delete: if isAdmin()
        || (isAuthed() && phoneMatches(resource.data.shopOwnerId));

      match /reel_comments/{commentId} {
        allow read: if true;
        // Accept userId match via uidIndex (myPhone) OR directly from the auth token
        // phone_number claim — guards against missing uidIndex on first login.
        allow create: if isAuthed()
          && (request.resource.data.userId == myPhone()
              || request.resource.data.userId == request.auth.token.phone_number);
        allow delete: if isAdmin()
          || (isAuthed() && phoneMatches(resource.data.userId))
          || (isAuthed() && resource.data.userId == request.auth.token.phone_number);
      }
    }

    // ─── reel_likes ──────────────────────────────────────────────────────────
    // Doc ID = {reelId}_{userId}. Any authenticated user can like/unlike.
    match /reel_likes/{likeId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    // ─── follows ─────────────────────────────────────────────────────────────
    // Doc ID = {followerId}_{shopId}. Any authenticated user can follow/unfollow.
    match /follows/{followId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    // ─── engagement_buffer ───────────────────────────────────────────────────
    // Server-only. recordEngagement (Cloud Functions, admin SDK) writes here
    // and flushEngagementNotifications drains it. No client has any business
    // reading it — it would expose every like/follow across all sellers — and
    // a client that could write to it could forge grouped notifications.
    match /engagement_buffer/{eventId} {
      allow read, write: if isAdmin();
    }

    // ─── engagement_groups ───────────────────────────────────────────────────
    // The actor list behind one grouped notification. Only the seller it was
    // built for may open it; writes stay server-side.
    match /engagement_groups/{groupId} {
      allow get: if isAdmin() || (isAuthed() && phoneMatches(resource.data.ownerPhone));
      allow list, write: if isAdmin();
    }

    // ─── reel_reports ────────────────────────────────────────────────────────
    // Any authenticated user may file a report against a reel. Nobody reads,
    // updates, or deletes them from the client — flagReelOnReports
    // (functions/src/index.ts) tallies them with the admin SDK, and a report
    // that could be edited or deleted by its author or the reported owner
    // would defeat the point of it.
    match /reel_reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAuthed() && request.resource.data.reporterId == myPhone();
    }

    // ─── blockedUsers ────────────────────────────────────────────────────────
    // One-directional block pairs, doc id `{blockerId}_{blockedId}`. Filtering
    // is entirely client-side (a viewer's blocklist shapes only what THEY
    // see, same pattern as moderationStatus on reels) — this collection only
    // needs to be readable by its own owner and admin, and never editable
    // (a block is created or removed, never modified).
    match /blockedUsers/{pairId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.blockerId == myPhone());
      allow create: if isAuthed()
        && request.resource.data.blockerId == myPhone()
        && request.resource.data.blockedId != myPhone()
        && pairId == request.resource.data.blockerId + '_' + request.resource.data.blockedId;
      allow update: if false;
      allow delete: if isAdmin() || (isAuthed() && resource.data.blockerId == myPhone());
    }

    // ─── contentReports ──────────────────────────────────────────────────────
    // The admin-facing moderation queue (Admin -> Moderation). Separate from
    // reel_reports (which only feeds the auto-hide-after-3-reports Cloud
    // Function and was never visible to a human) — every report AND every
    // block writes here too, so an admin has one place to review and act
    // within Apple's 24-hour requirement (Guideline 1.2). A reporter can only
    // ever create a 'pending' report on themselves; only admin resolves it.
    match /contentReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthed()
        && request.resource.data.reporterId == myPhone()
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    
    // ─── daySessions ─────────────────────────────────────────────────────────
    // One document per sales executive per working day.
    // The exec owns their own sessions; the Cloud Function (admin SDK) writes
    // totalDistanceKm + calculatedAt back — admin SDK bypasses client rules.
    match /daySessions/{sessionId} {
      // Owner-scoped for the exec's own /sales portal; admins may also read so
      // the Admin Panel "Sales Team" section can show an exec's daily sessions
      // (mirrors the isAdmin() read already granted on dealerVisits & dealers).
      // Read-only: create/update stay exec-owned, so this grants no admin writes.
      allow read:   if isAdmin()
                       || (isAuthed() && resource.data.salesExecutiveId == request.auth.uid);
      allow create: if isSalesExec()
                       && request.resource.data.salesExecutiveId == request.auth.uid
                       && request.resource.data.status == 'ACTIVE';
      allow update: if isAuthed() && resource.data.salesExecutiveId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── dealers ─────────────────────────────────────────────────────────────
    // Shared dealer master, created by Sales Executives via /sales/dealers and
    // read by the whole field team. Read/write is restricted to sales execs (or
    // admins) — previously ANY authenticated user (incl. customers) could read
    // the entire dealer master (shop name, owner, phone, address, geo). A sales
    // exec may only create docs carrying their own UID as createdBy, and may
    // only update their own records. Soft-delete (active=false) goes through
    // update. Hard-delete is admin-only.
    match /dealers/{dealerId} {
      allow read:   if isSalesExec() || isAdmin();
      allow create: if isSalesExec()
                       && request.resource.data.createdBy == request.auth.uid
                       && request.resource.data.active    == true;
      allow update: if (isSalesExec() && resource.data.createdBy == request.auth.uid)
                       || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── dealerVisits ─────────────────────────────────────────────────────────
    // One document per dealer visit logged by a sales executive.
    // A sales exec can only create/read/update visits tagged with their own UID.
    // Reads are OWNER-SCOPED: an exec sees only their own visits; admins see all
    // (admin SDK bypasses rules anyway, but isAdmin() covers admin client reads).
    // Every client query already filters where('salesExecutiveId','==',uid), so
    // owner-scoping breaks no existing read path while closing the prior hole
    // where ANY authenticated user (incl. customers) could read all visit data.
    // Hard-delete is admin-only.
    match /dealerVisits/{visitId} {
      allow read:   if isAdmin()
                       || (isAuthed() && resource.data.salesExecutiveId == request.auth.uid);
      allow create: if isSalesExec()
                       && request.resource.data.salesExecutiveId == request.auth.uid;
      allow update: if isAuthed()
                       && resource.data.salesExecutiveId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── salesAttendance ──────────────────────────────────────────────────────
    // One doc per sales executive per IST calendar day, id `{uid}_{date}`.
    // Written by the sales app: Start Day marks the rep present automatically,
    // and they can correct the day by hand (leave, half day, week off).
    //
    // The deterministic id is what makes a day markable only once, but an id is
    // not a permission — a rep could still write to someone else's `{uid}_{date}`
    // doc — so the salesExecutiveId/uid match below is what actually enforces
    // ownership, and the id prefix is deliberately NOT trusted on its own.
    match /salesAttendance/{docId} {
      allow read:   if isAdmin()
                       || (isAuthed() && resource.data.salesExecutiveId == request.auth.uid);
      allow create: if isSalesExec()
                       && request.resource.data.salesExecutiveId == request.auth.uid;
      // The owner may correct their own day; the salesExecutiveId can never be
      // reassigned, so a record cannot be moved onto another rep.
      allow update: if isAdmin()
                       || (isSalesExec()
                           && resource.data.salesExecutiveId == request.auth.uid
                           && request.resource.data.salesExecutiveId == resource.data.salesExecutiveId);
      allow delete: if isAdmin();
    }

    // ─── salesExpenses ────────────────────────────────────────────────────────
    // Field expense claims raised by a sales executive and reviewed by an admin.
    //
    // The whole point of the collection is that the REVIEW DECISION is not the
    // claimant's to make, so a rep may only ever write a PENDING document:
    //  · create — must be their own, and must start PENDING.
    //  · update — only their own, only while still PENDING, and it must stay
    //    PENDING. Without that last clause a rep could approve their own claim.
    //  · delete — withdrawing an un-reviewed claim is fine; once an admin has
    //    decided, the record is an audit trail and only an admin may remove it.
    match /salesExpenses/{expenseId} {
      allow read:   if isAdmin()
                       || (isAuthed() && resource.data.salesExecutiveId == request.auth.uid);
      allow create: if isSalesExec()
                       && request.resource.data.salesExecutiveId == request.auth.uid
                       && request.resource.data.status == 'PENDING';
      allow update: if isAdmin()
                       || (isSalesExec()
                           && resource.data.salesExecutiveId == request.auth.uid
                           && request.resource.data.salesExecutiveId == resource.data.salesExecutiveId
                           && resource.data.status == 'PENDING'
                           && request.resource.data.status == 'PENDING');
      allow delete: if isAdmin()
                       || (isSalesExec()
                           && resource.data.salesExecutiveId == request.auth.uid
                           && resource.data.status == 'PENDING');
    }

    // ─── erpHandoffCodes ──────────────────────────────────────────────────────
    // Single-use codes that are exchanged for an ERP sign-in token. Each document
    // is a bearer credential, so no client may read, list or write one — reading a
    // code would be enough to take over the matching ERP session. Both sides of the
    // exchange run in Cloud Functions, and the Admin SDK bypasses these rules.
    match /erpHandoffCodes/{codeHash} {
      allow read, write: if false;
    }
  }
}