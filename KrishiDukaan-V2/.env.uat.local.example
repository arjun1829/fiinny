# UAT secrets for local development — copy to .env.uat.local and fill in values.
# .env.uat.local is gitignored (matches .env*.local pattern). Ask Vinay for values.
#
# NOTE: FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY are NOT needed locally.
# The Admin SDK falls back to Application Default Credentials, so just run:
#   gcloud auth application-default login
# (with a @fiinny.com account that has access to the karan-arjun-uat project).

RAZORPAY_KEY_SECRET=rzp_test_your_secret_here

SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
