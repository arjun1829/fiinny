# UAT secrets for local development — copy to .env.uat.local and fill in values
# .env.uat.local is gitignored (matches .env*.local pattern)

RAZORPAY_KEY_SECRET=rzp_test_your_secret_here

# From karan-arjun-uat service account JSON (Project Settings → Service accounts → Generate key)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@karan-arjun-uat.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
