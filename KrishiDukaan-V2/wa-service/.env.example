# Firebase project ID (optional — defaults to krishidukan-e8315)
# FIREBASE_PROJECT_ID=krishidukan-e8315

# Auth is handled entirely via Application Default Credentials (ADC).
# No private key or service account JSON is stored here.
#
# Local dev  → run once: gcloud auth application-default login
# Google Cloud → ADC is injected automatically via the attached service account

# How often to poll for pending notifications (in minutes, default: 1)
POLL_INTERVAL_MINUTES=1

# Max messages to process per poll cycle (default: 10)
BATCH_SIZE=10
